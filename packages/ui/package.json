{
  "name": "@yuhshi/ui",
  "version": "0.1.0",
  "description": "Yuhshi component library for Android, iOS and web (React Native + react-native-web). Built only from @yuhshi/tokens and Yuhshi UI icons.",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": ">=19.3.0",
    "react-native": ">=0.88.0",
    "react-native-svg": ">=15.16.0"
  },
  "dependencies": {
    "@yuhshi/tokens": "workspace:*",
    "@yuhshi/icons": "workspace:*"
  },
  "devDependencies": {
    "@expo-google-fonts/figtree": "^0.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.11",
    "@types/react": "~19.3.3",
    "jsdom": "^31.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "typescript": "^7.0.2",
    "vitest": "5.1.2"
  }
}
